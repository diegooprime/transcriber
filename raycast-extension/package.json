{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "transcriber",
  "title": "Transcriber",
  "description": "Transcribe audio files with speaker diarization via AssemblyAI",
  "icon": "extension-icon.png",
  "author": "diegooprime",
  "categories": ["Productivity", "Media"],
  "license": "MIT",
  "commands": [
    {
      "name": "transcribe",
      "title": "Transcribe Audio",
      "description": "Select an audio file to transcribe with speaker labels",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "assemblyaiKey",
      "title": "AssemblyAI API Key",
      "description": "Your AssemblyAI API key for transcription",
      "type": "password",
      "required": true
    },
    {
      "name": "defaultLanguage",
      "title": "Default Language",
      "description": "Default transcription language",
      "type": "dropdown",
      "required": false,
      "default": "es",
      "data": [
        { "title": "Spanish", "value": "es" },
        { "title": "English", "value": "en" },
        { "title": "Portuguese", "value": "pt" },
        { "title": "French", "value": "fr" },
        { "title": "German", "value": "de" },
        { "title": "Italian", "value": "it" },
        { "title": "Japanese", "value": "ja" },
        { "title": "Chinese", "value": "zh" },
        { "title": "Korean", "value": "ko" }
      ]
    },
    {
      "name": "defaultSpeakers",
      "title": "Default Expected Speakers",
      "description": "Default number of speakers (leave empty for auto-detect)",
      "type": "textfield",
      "required": false
    },
    {
      "name": "outputDirectory",
      "title": "Output Directory",
      "description": "Where to save transcript .md files (default: ~/Desktop)",
      "type": "textfield",
      "required": false,
      "default": "~/Desktop"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.10",
    "@raycast/utils": "^1.19.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "~20.10.0",
    "@types/react": "^18.2.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "overrides": {
    "@types/react": "^18.2.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
